<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <title>Report Card</title>
  <style>
    {{{tailwindCss}}}
  </style>
  <style>
    body { font-family: 'Inter', sans-serif; -webkit-print-color-adjust: exact; print-color-adjust: exact; }
    .watermark {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%) rotate(-45deg);
      font-size: 8rem;
      font-weight: 900;
      color: rgba(225, 29, 72, 0.15);
      z-index: 100;
      pointer-events: none;
      white-space: nowrap;
    }
    .brand-text { color: {{primaryColor}}; }
    .brand-bg { background-color: {{primaryColor}}; }
    .brand-border { border-color: {{primaryColor}}; }
    .brand-bg-light { background-color: {{primaryColor}}20; } /* 20% opacity hex */
  </style>
</head>
<body class="bg-white text-slate-800 p-8 relative min-h-screen flex flex-col">
  {{#isPaid hasPaidFees}}
  {{else}}
    <div class="watermark">FEES PENDING</div>
  {{/isPaid}}

  <!-- Header -->
  <header class="flex justify-between items-center border-b-4 brand-border pb-6 mb-8">
    <div class="flex items-center">
      {{#if logoUrl}}
        <img src="{{logoUrl}}" class="w-20 h-20 object-contain mr-6" />
      {{else}}
        <div class="w-20 h-20 brand-bg rounded-full flex items-center justify-center text-white font-black text-3xl shadow-lg mr-6">
          NE
        </div>
      {{/if}}
      <div>
        <h1 class="text-3xl font-black text-slate-900 tracking-tight uppercase">{{schoolName}}</h1>
        <p class="text-slate-500 font-bold tracking-widest text-sm mt-1">Excellence in Education</p>
      </div>
    </div>
    <div class="text-right">
      <h2 class="text-2xl font-black brand-text">TERMINAL REPORT</h2>
      <p class="text-slate-500 font-bold">{{academicTerm}}</p>
    </div>
  </header>

  <!-- Student Info & Class Summary Grid -->
  <section class="grid grid-cols-4 gap-4 mb-6 bg-slate-50 p-5 rounded-2xl border border-slate-100">
    <div>
      <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1">Student Name</p>
      <p class="text-base font-black text-slate-900">{{studentName}}</p>
    </div>
    <div>
      <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1">Admission Number</p>
      <p class="text-base font-black text-slate-900">{{admissionNumber}}</p>
    </div>
    <div>
      <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1">Class / Arm</p>
      <p class="text-base font-black text-slate-900">{{className}}</p>
    </div>
    <div>
      <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1">Class Position</p>
      <p class="text-base font-black brand-text">{{positionOrdinal}} <span class="text-xs text-slate-400 font-bold">/ {{totalInClass}}</span></p>
    </div>
    <div class="pt-2 border-t border-slate-200">
      <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1">Total Score</p>
      <p class="text-base font-black text-slate-900">{{totalMarks}}</p>
    </div>
    <div class="pt-2 border-t border-slate-200">
      <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1">Student Average</p>
      <p class="text-base font-black text-slate-900">{{averageScore}}%</p>
    </div>
    <div class="pt-2 border-t border-slate-200">
      <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1">Class Average</p>
      <p class="text-base font-black text-slate-900">{{classAverage}}%</p>
    </div>
    <div class="pt-2 border-t border-slate-200">
      <p class="text-[10px] font-black text-slate-400 uppercase tracking-widest mb-1">Attendance</p>
      <p class="text-base font-black text-slate-900">{{daysPresent}} <span class="text-xs text-slate-400 font-bold">/ {{daysOpened}} days</span></p>
    </div>
  </section>

  {{#isPaid hasPaidFees}}
  <!-- Academic Record -->
  <section class="mb-6 flex-1">
    <h3 class="text-xs font-black text-slate-900 border-b-2 border-slate-200 pb-1 mb-3 uppercase tracking-widest">Academic Subject Performance</h3>
    <table class="w-full text-left border-collapse text-xs">
      <thead>
        <tr class="brand-bg-light border-b-2 brand-border">
          <th class="py-2.5 px-3 font-black brand-text uppercase w-1/3">Subject</th>
          <th class="py-2.5 px-3 font-black brand-text uppercase text-center">CA 1 (15)</th>
          <th class="py-2.5 px-3 font-black brand-text uppercase text-center">CA 2 (15)</th>
          <th class="py-2.5 px-3 font-black brand-text uppercase text-center">CA 3 (10)</th>
          <th class="py-2.5 px-3 font-black brand-text uppercase text-center">Exam (60)</th>
          <th class="py-2.5 px-3 font-black brand-text uppercase text-center">Total (100)</th>
          <th class="py-2.5 px-3 font-black brand-text uppercase text-center">Grade</th>
        </tr>
      </thead>
      <tbody class="divide-y divide-slate-100">
        {{#each scores}}
        <tr>
          <td class="py-2 px-3 font-bold text-slate-800">{{subject}}</td>
          <td class="py-2 px-3 text-center font-medium text-slate-600">{{ca1}}</td>
          <td class="py-2 px-3 text-center font-medium text-slate-600">{{ca2}}</td>
          <td class="py-2 px-3 text-center font-medium text-slate-600">{{ca3}}</td>
          <td class="py-2 px-3 text-center font-medium text-slate-600">{{exam}}</td>
          <td class="py-2 px-3 text-center font-black text-slate-900">{{totalScore}}</td>
          <td class="py-2 px-3 text-center font-black {{#if (eq gradingLetter 'F')}}text-rose-500{{else}}brand-text{{/if}}">{{gradingLetter}}</td>
        </tr>
        {{/each}}
      </tbody>
    </table>
  </section>

  <!-- Affective & Psychomotor Traits and Remarks -->
  <section class="grid grid-cols-2 gap-6 mb-6">
    <!-- Affective & Behavioral Domain -->
    <div>
      <h3 class="text-xs font-black text-slate-900 border-b-2 border-slate-200 pb-1 mb-2 uppercase tracking-widest">Behavioral & Psychomotor Ratings (1-5)</h3>
      <div class="grid grid-cols-2 gap-2 text-xs">
        <div class="flex justify-between items-center p-2 bg-slate-50 rounded-lg"><span class="font-bold text-slate-600">Punctuality</span><span class="font-black brand-text bg-white px-2 py-0.5 rounded border border-slate-200">{{punctuality}}/5</span></div>
        <div class="flex justify-between items-center p-2 bg-slate-50 rounded-lg"><span class="font-bold text-slate-600">Neatness</span><span class="font-black brand-text bg-white px-2 py-0.5 rounded border border-slate-200">{{neatness}}/5</span></div>
        <div class="flex justify-between items-center p-2 bg-slate-50 rounded-lg"><span class="font-bold text-slate-600">Teamwork</span><span class="font-black brand-text bg-white px-2 py-0.5 rounded border border-slate-200">{{teamwork}}/5</span></div>
        <div class="flex justify-between items-center p-2 bg-slate-50 rounded-lg"><span class="font-bold text-slate-600">Attentiveness</span><span class="font-black brand-text bg-white px-2 py-0.5 rounded border border-slate-200">5/5</span></div>
      </div>
    </div>

    <!-- Form Master Remark -->
    <div>
      <h3 class="text-xs font-black text-slate-900 border-b-2 border-slate-200 pb-1 mb-2 uppercase tracking-widest">Form Master's Remark</h3>
      <div class="bg-teal-50 border border-teal-100 rounded-xl p-3 italic text-xs font-medium text-slate-700 min-h-[70px]">
        "{{remark}}"
      </div>
    </div>
  </section>

  <!-- Principal's Appraisal & Signature Block -->
  <section class="grid grid-cols-2 gap-6 mb-4 pt-2 border-t-2 border-slate-200">
    <div>
      <h3 class="text-xs font-black text-slate-900 mb-1 uppercase tracking-widest">Principal's Final Remark</h3>
      <div class="bg-indigo-50 border border-indigo-100 rounded-xl p-3 text-xs font-medium text-slate-800">
        {{principalRemark}}
      </div>
    </div>
    
    <div class="flex justify-around items-center border border-slate-100 bg-slate-50 rounded-xl p-3">
      <!-- Digital Signature -->
      <div class="text-center">
        <div class="h-10 flex items-center justify-center font-serif italic font-black text-slate-800 border-b border-slate-300 px-4">
          {{principalSignatureName}}
        </div>
        <p class="text-[9px] font-black text-slate-400 uppercase tracking-widest mt-1">Principal's Signature</p>
      </div>

      <!-- Stamp Seal -->
      <div class="w-14 h-14 rounded-full border-2 border-dashed border-indigo-300 flex items-center justify-center text-[8px] font-black text-indigo-500 uppercase tracking-tighter text-center leading-tight rotate-[-12deg]">
        OFFICIAL<br/>SEAL
      </div>
    </div>
  </section>
  {{else}}
  <!-- Blocked Record -->
  <section class="flex-1 flex flex-col items-center justify-center bg-rose-50 border-2 border-dashed border-rose-200 rounded-3xl p-12 text-center">
    <div class="w-20 h-20 bg-rose-100 text-rose-500 rounded-full flex items-center justify-center mb-6">
      <svg class="w-10 h-10" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"/></svg>
    </div>
    <h3 class="text-2xl font-black text-rose-900 mb-2">Result Withheld</h3>
    <p class="text-rose-700 font-medium max-w-md">This academic report has been temporarily withheld pending fee clearance. Please contact the Bursary department to resolve this matter.</p>
  </section>
  {{/isPaid}}

  <footer class="mt-auto border-t-2 border-slate-100 pt-3 flex justify-between items-center text-[10px] font-bold text-slate-400">
    <div>Generated automatically by School Management Enterprise Platform</div>
    <div>{{currentDate}}</div>
  </footer>
</body>
</html>
