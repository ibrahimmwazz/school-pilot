generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model School {
  id                        String                      @id @default(uuid())
  name                      String
  createdAt                 DateTime                    @default(now()) @map("created_at")
  address                   String?
  phoneNumber               String?
  logoUrl                   String?                     @map("logo_url")
  primaryColor              String                      @default("#e11d48") @map("primary_color")
  brandColors               Json?                       @map("brand_colors")
  reportTemplateConfig      Json?                       @map("report_template_config")
  academicTerms             AcademicTerm[]
  assessment_weight_configs assessment_weight_configs[]
  auditLogs                 AuditLog[]
  classes                   Class[]
  curriculum_logs           curriculum_logs[]
  homeworks                 Homework[]
  lessonPlans               LessonPlan[]
  messages                  MessageLog[]
  students                  Student[]
  subjects                  Subject[]
  timetableEntries          TimetableEntry[]
  timetableSlots            TimetableSlot[]
  users                     User[]

  @@map("schools")
}

model User {
  id                    String                 @id @default(uuid())
  schoolId              String                 @map("school_id")
  email                 String                 @unique
  passwordHash          String                 @map("password_hash")
  role                  Role
  identityId            String?                @map("identity_id")
  createdAt             DateTime               @default(now()) @map("created_at")
  auditLogs             AuditLog[]
  classLocks            ClassLock[]
  formMasterAssignments FormMasterAssignment[]
  homeworks             Homework[]
  lessonPlans           LessonPlan[]
  messagesSent          MessageLog[]
  staffProfile          StaffProfile?
  assignments           TeacherAssignment[]
  timetableEntries      TimetableEntry[]
  school                School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("users")
}

model Student {
  id                      String                 @id @default(uuid())
  schoolId                String                 @map("school_id")
  admissionNumber         String                 @map("admission_number")
  firstName               String                 @map("first_name")
  lastName                String                 @map("last_name")
  middleName              String?                @map("middle_name")
  dateOfBirth             DateTime               @map("date_of_birth")
  gender                  Gender
  section                 String                 @default("Secondary")
  guardianName            String                 @default("") @map("guardian_name")
  guardianPhone           String                 @default("") @map("guardian_phone")
  guardianWhatsApp        String?                @map("guardian_whatsapp")
  guardianEmail           String?                @map("guardian_email")
  homeAddress             String?                @map("home_address")
  admissionDate           DateTime               @default(now()) @map("admission_date")
  status                  StudentStatus          @default(ACTIVE)
  isAlumni                Boolean                @default(false) @map("is_alumni")
  consentRenewedAt        DateTime?              @map("consent_renewed_at")
  allergies               String?
  blood_group             String?
  emergency_contact_name  String?
  emergency_contact_phone String?
  health_badges           Json?
  medical_instructions    String?
  enrollments             Enrollment[]
  first_aid_logs          first_aid_logs[]
  guardianLinks           GuardianLink[]
  immunization_records    immunization_records[]
  medication_schedules    medication_schedules[]
  pickup_delegates        pickup_delegates[]
  pickup_logs             pickup_logs[]
  school                  School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@unique([schoolId, admissionNumber])
  @@map("students")
}

model AcademicTerm {
  id                    String                 @id @default(uuid())
  schoolId              String                 @map("school_id")
  year                  String
  termName              TermName               @map("term_name")
  isActive              Boolean                @default(false) @map("is_active")
  school                School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  classLocks            ClassLock[]
  enrollments           Enrollment[]
  formMasterAssignments FormMasterAssignment[]
  homeworks             Homework[]
  lessonPlans           LessonPlan[]
  assignments           TeacherAssignment[]
  timetableEntries      TimetableEntry[]

  @@unique([schoolId, year, termName])
  @@map("academic_terms")
}

model Class {
  id                    String                 @id @default(uuid())
  schoolId              String                 @map("school_id")
  name                  String
  arm                   String?
  classLocks            ClassLock[]
  school                School                 @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  enrollments           Enrollment[]
  formMasterAssignments FormMasterAssignment[]
  homeworks             Homework[]
  lessonPlans           LessonPlan[]
  assignments           TeacherAssignment[]
  timetableEntries      TimetableEntry[]

  @@unique([schoolId, name, arm])
  @@index([schoolId])
  @@map("classes")
}

model Enrollment {
  id                                String                             @id @default(uuid())
  studentId                         String                             @map("student_id")
  classId                           String                             @map("class_id")
  academicTermId                    String                             @map("academic_term_id")
  developmental_progress_statements developmental_progress_statements?
  academicTerm                      AcademicTerm                       @relation(fields: [academicTermId], references: [id], onDelete: Cascade)
  class                             Class                              @relation(fields: [classId], references: [id], onDelete: Cascade)
  student                           Student                            @relation(fields: [studentId], references: [id], onDelete: Cascade)
  milestone_assessments             milestone_assessments[]
  scores                            Score[]
  termRecord                        StudentTermRecord?

  @@unique([studentId, academicTermId])
  @@index([classId, academicTermId])
  @@map("enrollments")
}

model Subject {
  id               String              @id @default(uuid())
  schoolId         String              @map("school_id")
  name             String
  code             String
  homeworks        Homework[]
  lessonPlans      LessonPlan[]
  scores           Score[]
  school           School              @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  assignments      TeacherAssignment[]
  timetableEntries TimetableEntry[]

  @@unique([schoolId, code])
  @@map("subjects")
}

model TeacherAssignment {
  id             String       @id @default(uuid())
  staffId        String       @map("staff_id")
  subjectId      String       @map("subject_id")
  classId        String       @map("class_id")
  academicTermId String       @map("academic_term_id")
  academicTerm   AcademicTerm @relation(fields: [academicTermId], references: [id], onDelete: Cascade)
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher        User         @relation(fields: [staffId], references: [id], onDelete: Cascade)
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([staffId, subjectId, classId, academicTermId])
  @@index([staffId])
  @@index([academicTermId])
  @@map("teacher_assignments")
}

model FormMasterAssignment {
  id             String       @id @default(uuid())
  staffId        String       @map("staff_id")
  classId        String       @map("class_id")
  academicTermId String       @map("academic_term_id")
  academicTerm   AcademicTerm @relation(fields: [academicTermId], references: [id], onDelete: Cascade)
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  teacher        User         @relation(fields: [staffId], references: [id], onDelete: Cascade)

  @@unique([staffId, classId, academicTermId])
  @@index([staffId])
  @@map("form_master_assignments")
}

model StudentTermRecord {
  id                String     @id @default(uuid())
  enrollmentId      String     @unique @map("enrollment_id")
  daysOpened        Int        @default(0) @map("days_opened")
  daysPresent       Int        @default(0) @map("days_present")
  attendanceTracker Json?      @map("attendance_tracker")
  punctuality       Int        @default(1)
  neatness          Int        @default(1)
  teamwork          Int        @default(1)
  formMasterRemark  String?    @map("form_master_remark")
  principalRemark   String?    @map("principal_remark")
  hasPaidFees       Boolean    @default(true) @map("has_paid_fees")
  enrollment        Enrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@map("student_term_records")
}

model Score {
  id             String         @id @default(uuid())
  enrollmentId   String         @map("enrollment_id")
  subjectId      String         @map("subject_id")
  ca1            Float?         @map("ca_1")
  ca2            Float?         @map("ca_2")
  ca3            Float?         @map("ca_3")
  exam           Float?
  totalScore     Float?         @map("total_score")
  gradingLetter  String?        @map("grading_letter")
  syncStatus     SyncStatus     @default(SYNCED) @map("sync_status")
  approvalStatus ApprovalStatus @default(DRAFT) @map("approval_status")
  updatedBy      String?        @map("updated_by")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  enrollment     Enrollment     @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  subject        Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, subjectId])
  @@index([enrollmentId])
  @@map("scores")
}

model ClassLock {
  id             String       @id @default(uuid())
  classId        String       @map("class_id")
  academicTermId String       @map("academic_term_id")
  isLocked       Boolean      @default(false) @map("is_locked")
  lockedById     String?      @map("locked_by")
  lockedAt       DateTime?    @map("locked_at")
  academicTerm   AcademicTerm @relation(fields: [academicTermId], references: [id], onDelete: Cascade)
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  lockedBy       User?        @relation(fields: [lockedById], references: [id])

  @@unique([classId, academicTermId])
  @@map("class_locks")
}

model Guardian {
  id               String             @id @default(uuid())
  firstName        String             @map("first_name")
  lastName         String             @map("last_name")
  email            String?
  phoneNumber      String?            @map("phone_number")
  guardianLinks    GuardianLink[]
  pickup_delegates pickup_delegates[]

  @@map("guardians")
}

model GuardianLink {
  id           String   @id @default(uuid())
  guardianId   String   @map("guardian_id")
  studentId    String   @map("student_id")
  relationship String
  isRevoked    Boolean  @default(false) @map("is_revoked")
  guardian     Guardian @relation(fields: [guardianId], references: [id], onDelete: Cascade)
  student      Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([guardianId, studentId])
  @@map("guardian_links")
}

model TimetableSlot {
  id        String           @id @default(uuid())
  schoolId  String           @map("school_id")
  startTime String           @map("start_time")
  endTime   String           @map("end_time")
  order     Int
  entries   TimetableEntry[]
  school    School           @relation(fields: [schoolId], references: [id], onDelete: Cascade)

  @@map("timetable_slots")
}

model TimetableEntry {
  id             String        @id @default(uuid())
  schoolId       String        @map("school_id")
  academicTermId String        @map("academic_term_id")
  classId        String        @map("class_id")
  subjectId      String        @map("subject_id")
  teacherId      String?       @map("teacher_id")
  slotId         String        @map("slot_id")
  dayOfWeek      Int
  term           AcademicTerm  @relation(fields: [academicTermId], references: [id], onDelete: Cascade)
  class          Class         @relation(fields: [classId], references: [id], onDelete: Cascade)
  school         School        @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  slot           TimetableSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  subject        Subject       @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher        User?         @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@unique([classId, academicTermId, dayOfWeek, slotId])
  @@index([schoolId, academicTermId])
  @@index([teacherId, academicTermId])
  @@index([classId, academicTermId])
  @@map("timetable_entries")
}

model MessageLog {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  senderId  String   @map("sender_id")
  recipient String
  content   String
  status    String
  type      String
  createdAt DateTime @default(now()) @map("created_at")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  sender    User     @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
  @@map("message_logs")
}

model LessonPlan {
  id             String         @id @default(uuid())
  schoolId       String         @map("school_id")
  teacherId      String         @map("teacher_id")
  subjectId      String         @map("subject_id")
  classId        String         @map("class_id")
  academicTermId String         @map("academic_term_id")
  weekNumber     Int            @map("week_number")
  title          String
  content        String
  status         ApprovalStatus @default(DRAFT)
  createdAt      DateTime       @default(now()) @map("created_at")
  updatedAt      DateTime       @updatedAt @map("updated_at")
  academicTerm   AcademicTerm   @relation(fields: [academicTermId], references: [id], onDelete: Cascade)
  class          Class          @relation(fields: [classId], references: [id], onDelete: Cascade)
  school         School         @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject        Subject        @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher        User           @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, academicTermId])
  @@map("lesson_plans")
}

model Homework {
  id             String       @id @default(uuid())
  schoolId       String       @map("school_id")
  teacherId      String       @map("teacher_id")
  subjectId      String       @map("subject_id")
  classId        String       @map("class_id")
  academicTermId String       @map("academic_term_id")
  title          String
  description    String
  dueDate        DateTime     @map("due_date")
  createdAt      DateTime     @default(now()) @map("created_at")
  academicTerm   AcademicTerm @relation(fields: [academicTermId], references: [id], onDelete: Cascade)
  class          Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  school         School       @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  subject        Subject      @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  teacher        User         @relation(fields: [teacherId], references: [id], onDelete: Cascade)

  @@index([teacherId, academicTermId])
  @@map("homework")
}

model StaffProfile {
  id               String   @id @default(uuid())
  userId           String   @unique @map("user_id")
  staffId          String   @map("staff_id")
  surname          String
  firstName        String   @map("first_name")
  middleName       String?  @map("middle_name")
  dateOfBirth      DateTime @map("date_of_birth")
  gender           String
  section          String
  phone            String
  whatsappNumber   String?  @map("whatsapp_number")
  homeAddress      String?  @map("home_address")
  resumptionDate   DateTime @map("resumption_date")
  employmentStatus String   @default("Active") @map("employment_status")
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, staffId])
  @@map("staff_profiles")
}

model AuditLog {
  id        String   @id @default(uuid())
  schoolId  String   @map("school_id")
  userId    String   @map("user_id")
  action    String
  details   Json?
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")
  school    School   @relation(fields: [schoolId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([schoolId, createdAt])
  @@map("audit_logs")
}

model assessment_weight_configs {
  id                String  @id
  school_id         String
  class_id          String?
  academic_term_id  String?
  attendance_weight Float   @default(10)
  homework_weight   Float   @default(10)
  ca_weight         Float   @default(20)
  exam_weight       Float   @default(60)
  schools           School  @relation(fields: [school_id], references: [id], onDelete: Cascade)
}

model curriculum_logs {
  id               String         @id
  school_id        String
  teacher_id       String
  subject_id       String
  class_id         String
  academic_term_id String
  week_number      Int
  topic_covered    String
  status           ApprovalStatus @default(DRAFT)
  admin_feedback   String?
  created_at       DateTime       @default(now())
  updated_at       DateTime
  schools          School         @relation(fields: [school_id], references: [id], onDelete: Cascade)

  @@index([school_id, teacher_id])
}

model developmental_progress_statements {
  id               String     @id
  enrollment_id    String     @unique
  narrative_notes  String?
  skill_checklist  Json?
  photo_highlights Json?
  term             String?
  enrollments      Enrollment @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)
}

model first_aid_logs {
  id              String   @id
  student_id      String
  incident        String
  treatment       String
  administered_by String
  timestamp       DateTime @default(now())
  notes           String?
  students        Student  @relation(fields: [student_id], references: [id], onDelete: Cascade)
}

model immunization_records {
  id                String   @id
  student_id        String
  vaccine_name      String
  date_administered DateTime
  status            String   @default("COMPLETED")
  notes             String?
  created_at        DateTime @default(now())
  students          Student  @relation(fields: [student_id], references: [id], onDelete: Cascade)
}

model medication_schedules {
  id              String   @id
  student_id      String
  medication_name String
  dosage          String
  frequency       String
  time_of_day     String
  notes           String?
  is_active       Boolean  @default(true)
  created_at      DateTime @default(now())
  students        Student  @relation(fields: [student_id], references: [id], onDelete: Cascade)
}

model milestone_assessments {
  id            String              @id
  enrollment_id String
  domain        DevelopmentalDomain
  skill_name    String
  rating        RubricRating
  teacher_notes String?
  evaluated_at  DateTime            @default(now())
  enrollments   Enrollment          @relation(fields: [enrollment_id], references: [id], onDelete: Cascade)

  @@index([enrollment_id])
}

model pickup_delegates {
  id                 String        @id
  student_id         String
  guardian_id        String?
  full_name          String
  relationship       String
  phone              String
  photo_url          String?
  pin_code           String?
  qr_code            String?
  security_clearance Boolean       @default(true)
  created_at         DateTime      @default(now())
  guardians          Guardian?     @relation(fields: [guardian_id], references: [id])
  students           Student       @relation(fields: [student_id], references: [id], onDelete: Cascade)
  pickup_logs        pickup_logs[]
}

model pickup_logs {
  id                  String            @id
  student_id          String
  delegate_id         String?
  logged_by           String?
  verification_method String
  signature_url       String?
  timestamp           DateTime          @default(now())
  status              String            @default("APPROVED")
  notes               String?
  pickup_delegates    pickup_delegates? @relation(fields: [delegate_id], references: [id])
  students            Student           @relation(fields: [student_id], references: [id], onDelete: Cascade)

  @@index([student_id, timestamp])
}

enum Role {
  ADMIN
  PRINCIPAL
  HEAD_MASTER
  TEACHER
  FORM_MASTER
  BURSAR
  PARENT
  STUDENT
  EARLY_CHILDHOOD_LEAD
  MAINSTREAM_HEAD
  EARLY_YEARS_EDUCATOR
  PICKUP_DELEGATE
  MEDICAL_OFFICER
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum StudentStatus {
  ACTIVE
  INACTIVE
  GRADUATED
  SUSPENDED
}

enum TermName {
  TERM_1
  TERM_2
  TERM_3
}

enum SyncStatus {
  LOCAL_ONLY
  SYNCED
}

enum ApprovalStatus {
  DRAFT
  SUBMITTED
  FINALIZED
}

enum DevelopmentalDomain {
  GROSS_FINE_MOTOR
  LANGUAGE_SPEECH
  SOCIAL_EMOTIONAL
  COGNITIVE_DISCOVERY
}

enum RubricRating {
  MASTERED
  DEVELOPING
  NEEDS_SUPPORT
}
